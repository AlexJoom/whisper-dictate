[Desktop Entry]
Type=Application
Name=Whisper Dictate
Comment=Push-to-talk voice dictation (Greek + English) with local Whisper
Exec=@EXEC@
Icon=audio-input-microphone
Terminal=false
Categories=Utility;Accessibility;AudioVideo;
Keywords=dictation;speech;voice;whisper;typing;
StartupNotify=false
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=5
